import "../src/abla-mvc.ab"

fun main: int {
    val value = 42
    val view = $mvcview
        <custom-card id='answer' aria-label="Answer" data-value={value} hidden>
            <input disabled data-mode='compact'>
            <svg><path xlink:href="#answer" /></svg>
            <br>
            {value}
        </custom-card>
    if (view.render() ==
        "<custom-card id=\"answer\" aria-label=\"Answer\" data-value=\"42\" hidden>\n            <input disabled data-mode=\"compact\">\n            <svg><path xlink:href=\"#answer\" /></svg>\n            <br>\n            42\n        </custom-card>") 0 else 1
}
