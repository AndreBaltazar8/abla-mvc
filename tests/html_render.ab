import "../src/abla-mvc.ab"

// Keep the prior renderer as an independent byte-for-byte oracle.
fun htmlRenderReference(view: MvcHtml): string {
    var output = ""
    if (view.kind == 2) output = mvcEscapeHtml(view.text)
    if (view.kind == 1) {
        output = "<${view.tag}"
        for (attribute in view.attributes) {
            output = "$output ${attribute.name}"
            if (!attribute.boolean) output = "$output=\"${mvcEscapeHtml(attribute.value)}\""
        }
        if (view.closing == 2) output = "$output />"
        else output = "$output>"
        var index = 0
        while (view.closing == 1 && index < view.children.size) {
            output = "$output${htmlRenderReference(view.children[index])}"
            index += 1
        }
        if (view.closing == 1) output = "$output</${view.tag}>"
    }
    output
}

fun htmlRenderMatches(view: MvcHtml): bool = view.render() == htmlRenderReference(view)

fun htmlRenderSmallCases(): bool {
    val attributes = [mvcHtmlAttribute("title", "<&\"'é\x00"),
        mvcHtmlBooleanAttribute("checked"), mvcHtmlAttribute("title", "last")]
    for (kind in [0, 1, 2, 3]) {
        for (closing in [-1, 0, 1, 2, 3]) {
            val node = MvcHtml(kind, "x", "text <&> \"🙂\"\x00", attributes,
                [mvcHtmlText("child <&>"), mvcHtmlElement("i", [], [])], closing)
            if (!htmlRenderMatches(node)) return false
        }
    }
    htmlRenderMatches(mvcHtmlElement("", [], [])) &&
        htmlRenderMatches(mvcHtmlText("")) &&
        htmlRenderMatches(mvcHtmlElement("raw tag", [mvcHtmlAttribute("a&", "v")], []))
}

val htmlRenderedAtCompileTime = #htmlRenderSmallCases()
var htmlRenderSeed = 1234567
fun htmlRenderRandom(limit: int): int {
    htmlRenderSeed = (htmlRenderSeed * 1103515245 + 12345) % 2147483648
    (htmlRenderSeed / 65536) % limit
}
fun htmlRenderRandomNode(depth: int): MvcHtml {
    val texts = ["", "plain", "  \n\t", "<&>\"'", "店 & André 🙂", "\x00\xfftail"]
    val tags = ["p", "span", "input", "custom-tag", ""]
    val names = ["title", "id", "checked", "title"]
    val attributes: array<MvcHtmlAttribute> = []
    for (index in 0 until htmlRenderRandom(4)) {
        attributes.append(MvcHtmlAttribute(names[htmlRenderRandom(names.size)],
            texts[htmlRenderRandom(texts.size)], htmlRenderRandom(3) == 0))
    }
    val children: array<MvcHtml> = []
    if (depth > 0) {
        for (index in 0 until htmlRenderRandom(4)) children.append(htmlRenderRandomNode(depth - 1))
    }
    val choice = htmlRenderRandom(5)
    MvcHtml(if (choice < 3) 1 else if (choice == 3) 2 else 0,
        tags[htmlRenderRandom(tags.size)], texts[htmlRenderRandom(texts.size)],
        attributes, children, htmlRenderRandom(4))
}

fun htmlRenderMarkupBoundaries(): bool {
    var pattern = "é店\x00\xff<&>\"'"
    while (pattern.size < 8192) pattern = pattern + pattern
    for (length in [0, 1, 2, 3, 4, 7, 8, 31, 63, 64, 65,
                   251, 252, 253, 254, 255, 256, 257, 4095, 4096, 4097]) {
        val name = pattern.slice(1, length + 1)
        // Force buffered traversal with three attributes, including raw names
        // at the combined token's short/large threshold and unaligned bytes.
        val attributes = [mvcHtmlAttribute(name, "<&>\"'"),
            mvcHtmlBooleanAttribute(name), mvcHtmlAttribute("", "")]
        for (closing in [-1, 0, 1, 2, 3]) {
            if (!htmlRenderMatches(MvcHtml(1, name, "", attributes,
                [mvcHtmlText("tail")], closing))) return false
        }
    }
    true
}

fun main: int {
    if (!htmlRenderedAtCompileTime || !htmlRenderSmallCases() || !htmlRenderMarkupBoundaries()) return 1
    for (index in 0 until 1000) {
        if (!htmlRenderMatches(htmlRenderRandomNode(4))) return 2
    }
    var tree = mvcHtmlText("deep <&>é")
    for (depth in 0 until 64) tree = mvcHtmlElement("div", [], [tree])
    if (!htmlRenderMatches(tree)) return 3
    // Non-normal closing modes and missing kinds must not visit children.
    val ignored = MvcHtml(1, "void", "", [mvcHtmlBooleanAttribute("x"), mvcHtmlAttribute("y", "<&>")], [], 2)
    ignored.children.append(ignored)
    if (!htmlRenderMatches(ignored)) return 4
    0
}
