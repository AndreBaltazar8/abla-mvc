import "../src/abla-mvc.ab"
import "../src/action_core.ab"
import "../src/html.ab"

fun invalidAction(value: bool): MvcAction =
    replace("#result", mvcHtmlText("$value"))

fun main: int {
    val view = $mvcview <button onclick={invalidAction(true)}>Invalid</button>
    if (view.render() == "") 1 else 0
}
