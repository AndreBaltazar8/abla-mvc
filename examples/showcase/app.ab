#import("abla/sys/linux")
#import("static.ab")
#import("models/counter.ab")
#import("models/session.ab")
#import("views/counter_view.ab")
#import("controllers/counter_controller.ab")
#import("controllers/client_counter_controller.ab")
#import("views/home_view.ab")
#import("views/auth_view.ab")
#import("controllers/home_controller.ab")
#import("controllers/auth_controller.ab")

fun applicationHealth(request: HttpRequest): HttpResponse = httpText("ok")

fun main: int {
    val application = httpRouter()
    val actions = mvcGeneratedActions()

    application.get("/", dashboardIndex)
    application.get("/login", loginPage)
    application.post("/login", loginSubmit)
    application.post("/logout", logoutSubmit)
    application.get("/health", applicationHealth)
    application.get("/assets/:name", showcaseStaticAsset)
    application.get("/__abla/mvc.js", mvcBrowserRuntimeEndpoint)
    application.post(
        "/__abla/action/:name",
        protectedActionHttpHandler(actions)
    )
    serveHttp(application, 8080)
}
