import "abla/bytes"

class MvcHtmlAttribute(
    val name: string,
    val value: string,
    val boolean: bool
)

// Kinds: 1 element, 2 escaped text, 3 raw text (the literal body of a <script> or <style> in a template: source text, written as it is).
class MvcHtml(
    val kind: int,
    val tag: string,
    val text: string,
    val attributes: array<MvcHtmlAttribute>,
    val children: array<MvcHtml>,
    val closing: int
)

fun mvcHtmlAttribute(name: string, value: string): MvcHtmlAttribute =
    MvcHtmlAttribute(name, value, false)

fun mvcHtmlAttributeValue(name: string, value: any): MvcHtmlAttribute =
    MvcHtmlAttribute(name, "$value", false)

/// A value the program wrote or fully checked, past $mvcview's URL and event-handler checks: `href={mvcTrusted(url)}` keeps a data: or
/// javascript: URL, `onload={mvcTrusted(code)}` compiles. It is the only way past them, so a search for mvcTrusted finds every exception.
class MvcTrusted(val value: string)

/// Marks `value` as trusted for one $mvcview attribute hole (see MvcTrusted). Never pass a value a user supplied.
fun mvcTrusted(value: string): MvcTrusted = MvcTrusted(value)

fun mvcHtmlAttributeValue(name: string, value: MvcTrusted): MvcHtmlAttribute =
    MvcHtmlAttribute(name, value.value, false)

// A $mvcview hole in a URL attribute: a value whose scheme runs script or carries a document is written as mvcHtmlUnsafeUrl.
fun mvcHtmlUrlAttributeValue(name: string, value: any): MvcHtmlAttribute =
    MvcHtmlAttribute(name, mvcHtmlSafeUrl("$value"), false)

fun mvcHtmlUrlAttributeValue(name: string, value: MvcTrusted): MvcHtmlAttribute =
    MvcHtmlAttribute(name, value.value, false)

/// Whether a lowercase attribute name takes a URL that a browser follows or loads (href, src, action, formaction and the like).
fun mvcHtmlUrlAttributeName(name: string): bool =
    name == "href" || name == "src" || name == "action" || name == "formaction" || name == "poster" || name == "cite" ||
    name == "xlink:href" || name == "background" || name == "longdesc" || name == "usemap" || name == "codebase" ||
    name == "classid" || name == "data" || name == "manifest" || name == "icon" || name == "ping" || name == "lowsrc" ||
    name == "dynsrc" || name == "archive" || name == "profile"

/// Whether a lowercase attribute name is an event handler (on...), whose value runs as script.
fun mvcHtmlEventAttributeName(name: string): bool = name.size > 2 && name[0] == 111 && name[1] == 110

/// The value written in place of a URL whose scheme runs script or carries a document.
val mvcHtmlUnsafeUrl = "about:invalid#abla-unsafe-url"

// One character reference at `at` (after its "&"): [the decoded byte (128 for any non-ASCII), where it ends], or [-1, at].
private fun mvcHtmlReferenceByte(value: string, at: int): array<int> {
    if (at < value.size && value[at] == 35) {
        var i = at + 1
        val hex = i < value.size && (value[i] == 120 || value[i] == 88)
        if (hex) i = i + 1
        var code = 0
        val digits = i
        var reading = true
        while (reading && i < value.size && i - digits < 8) {
            val b = value[i]
            val digit = if (b >= 48 && b <= 57) b - 48
                else if (hex && b >= 97 && b <= 102) b - 87
                else if (hex && b >= 65 && b <= 70) b - 55
                else -1
            if (digit < 0) reading = false
            else {
                code = code * (if (hex) 16 else 10) + digit
                i = i + 1
            }
        }
        if (i == digits) return [-1, at]
        if (i < value.size && value[i] == 59) i = i + 1
        return [if (code < 128) code else 128, i]
    }
    if (mvcHtmlNamedAt(value, at, "colon;")) return [58, at + 6]
    if (mvcHtmlNamedAt(value, at, "tab;")) return [9, at + 4]
    if (mvcHtmlNamedAt(value, at, "newline;")) return [10, at + 8]
    [-1, at]
}

// Whether `name` (lowercase) is at `at` in `value`, in any case.
private fun mvcHtmlNamedAt(value: string, at: int, name: string): bool {
    if (at + name.size > value.size) return false
    var i = 0
    while (i < name.size) {
        val b = value[at + i]
        val lower = if (b >= 65 && b <= 90) b + 32 else b
        if (lower != name[i]) return false
        i = i + 1
    }
    true
}

/// `value` if it is safe in a URL attribute, else mvcHtmlUnsafeUrl: its scheme, read as a browser does (character references decoded,
/// whitespace and control characters anywhere dropped, any case), must not be javascript:, vbscript: or data:.
fun mvcHtmlSafeUrl(value: string): string {
    // The scheme so far, lowercase; any byte but a letter is "_" (no refused scheme has one).
    var scheme = ""
    val letters = "abcdefghijklmnopqrstuvwxyz"
    var i = 0
    var length = 0
    while (i < value.size && length < 16) {
        var b = value[i]
        i = i + 1
        if (b == 38) {
            val decoded = mvcHtmlReferenceByte(value, i)
            if (decoded[0] >= 0) { b = decoded[0]; i = decoded[1] }
        }
        if (b > 32 && b != 127) {
            if (b == 58) return if (scheme == "javascript" || scheme == "vbscript" || scheme == "data") mvcHtmlUnsafeUrl else value
            if (b == 47 || b == 63 || b == 35) return value
            val lower = if (b >= 65 && b <= 90) b + 32 else b
            scheme = if (lower >= 97 && lower <= 122) "$scheme${letters.slice(lower - 97, lower - 96)}" else "${scheme}_"
            length = length + 1
        }
    }
    value
}

fun mvcHtmlBooleanAttribute(name: string): MvcHtmlAttribute =
    MvcHtmlAttribute(name, "", true)

fun mvcHtmlElement(
    tag: string,
    attributes: array<MvcHtmlAttribute>,
    children: array<MvcHtml>
): MvcHtml = MvcHtml(1, tag, "", attributes, children, 1)

fun mvcHtmlVoidElement(
    tag: string,
    attributes: array<MvcHtmlAttribute>
): MvcHtml = MvcHtml(1, tag, "", attributes, [], 0)

fun mvcHtmlSelfClosingElement(
    tag: string,
    attributes: array<MvcHtmlAttribute>
): MvcHtml = MvcHtml(1, tag, "", attributes, [], 2)

fun mvcHtmlText(value: string): MvcHtml = MvcHtml(2, "", value, [], [], 0)

// The literal text of a <script> or <style> element in a $mvcview template, written unescaped (HTML escaping would change the code; the
// template parser refuses holes there, since escaping cannot make a value safe as script or style).
fun mvcHtmlRawText(value: string): MvcHtml = MvcHtml(3, "", value, [], [], 0)

fun mvcHtmlDynamic(value: any): MvcHtml = mvcHtmlText("$value")

private fun mvcHtmlNeedsEscape(byte: int): bool =
    byte == 38 || byte == 60 || byte == 62 || byte == 34 || byte == 39

private fun mvcHtmlEscapeEntity(byte: int): string =
    if (byte == 38) "&amp;"
    else if (byte == 60) "&lt;"
    else if (byte == 62) "&gt;"
    else if (byte == 34) "&quot;"
    else "&#39;"

private fun mvcHtmlAppendEscaped(
    var output: ByteBuffer,
    value: string
): void {
    val size = value.size
    var index = 0
    var begin = 0
    while (index < size) {
        if (mvcHtmlNeedsEscape(value[index])) {
            if (index > begin) output.appendText(value.slice(begin, index))
            output.appendText(mvcHtmlEscapeEntity(value[index]))
            begin = index + 1
        }
        index = index + 1
    }
    if (begin < size) output.appendText(value.slice(begin, size))
}

fun mvcEscapeHtml(value: string): string {
    val size = value.size
    var index = 0
    while (index < size && !mvcHtmlNeedsEscape(value[index])) index += 1
    // Ordinary text, including the empty string, needs no allocation or copy.
    if (index == size) return value
    if (size == 1) return mvcHtmlEscapeEntity(value[index])

    val output = byteBuffer()
    var begin = 0
    // Continue at the first hit: do not rescan the already checked prefix.
    while (index < size) {
        if (mvcHtmlNeedsEscape(value[index])) {
            if (index > begin) output.appendText(value.slice(begin, index))
            output.appendText(mvcHtmlEscapeEntity(value[index]))
            begin = index + 1
        }
        index = index + 1
    }
    if (begin < size) output.appendText(value.slice(begin, size))
    output.toText()
}

// kind: 1 opening tag, 2 closing tag, 3 boolean attribute, 4 valued attribute.
// Emit punctuation and a raw tag/attribute name.
private fun mvcHtmlAppendMarkup(var output: ByteBuffer, name: string, kind: int): void {
    if (kind == 2) output.appendText("</")
    else if (kind >= 3) output.appendText(" ")
    else output.appendText("<")
    output.appendText(name)
    if (kind == 2) output.appendText(">")
    else if (kind == 4) output.appendText("=\"")
}

private fun mvcHtmlRenderInto(view: MvcHtml, var output: ByteBuffer): void {
    if (view.kind == 2) {
        mvcHtmlAppendEscaped(output, view.text)
        return
    }
    if (view.kind == 3) {
        output.appendText(view.text)
        return
    }
    if (view.kind != 1) return
    mvcHtmlAppendMarkup(output, view.tag, 1)
    for (attribute in view.attributes) {
        mvcHtmlAppendMarkup(output, attribute.name, if (attribute.boolean) 3 else 4)
        if (!attribute.boolean) {
            mvcHtmlAppendEscaped(output, attribute.value)
            output.appendText("\"")
        }
    }
    if (view.closing == 2) output.appendText(" />")
    else output.appendText(">")
    if (view.closing == 1) {
        for (child in view.children) mvcHtmlRenderInto(child, output)
        mvcHtmlAppendMarkup(output, view.tag, 2)
    }
}

private fun mvcHtmlRenderBuffered(view: MvcHtml): string {
    val output = byteBuffer()
    mvcHtmlRenderInto(view, output)
    output.toText()
}

fun MvcHtml.render(): string {
    if (this.kind != 1) {
        if (this.kind == 2) return mvcEscapeHtml(this.text)
        if (this.kind == 3) return this.text
        return ""
    }
    // A leaf with few pieces is cheaper as direct templates. Branched trees
    // share one buffer, without creating a rendered string for each child.
    if (this.attributes.size + this.children.size > 2) return mvcHtmlRenderBuffered(this)
    var output = ""
    output = "<${this.tag}"
    var attributeIndex = 0
    while (attributeIndex < this.attributes.size) {
        val attribute = this.attributes[attributeIndex]
        output = "$output ${attribute.name}"
        if (!attribute.boolean) {
            output = "$output=\"${mvcEscapeHtml(attribute.value)}\""
        }
        attributeIndex = attributeIndex + 1
    }
    if (this.closing == 2) output = "$output />"
    else output = "$output>"
    var childIndex = 0
    while (this.closing == 1 && childIndex < this.children.size) {
        output = "$output${this.children[childIndex].render()}"
        childIndex = childIndex + 1
    }
    if (this.closing == 1) output = "$output</${this.tag}>"

    output
}
