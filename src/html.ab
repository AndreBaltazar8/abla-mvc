import "abla/bytes"
import "abla/unsafe/memory/raw"

class MvcHtmlAttribute(
    val name: string,
    val value: string,
    val boolean: bool
)

// Kinds: 1 element, 2 escaped text.
class MvcHtml(
    val kind: int,
    val tag: string,
    val text: string,
    val attributes: array<MvcHtmlAttribute>,
    val children: array<MvcHtml>,
    val closing: int
)

fun mvcHtmlAttribute(name: string, value: string): MvcHtmlAttribute =
    MvcHtmlAttribute(name, value, false)

fun mvcHtmlAttributeValue(name: string, value: any): MvcHtmlAttribute =
    MvcHtmlAttribute(name, "$value", false)

fun mvcHtmlBooleanAttribute(name: string): MvcHtmlAttribute =
    MvcHtmlAttribute(name, "", true)

fun mvcHtmlElement(
    tag: string,
    attributes: array<MvcHtmlAttribute>,
    children: array<MvcHtml>
): MvcHtml = MvcHtml(1, tag, "", attributes, children, 1)

fun mvcHtmlVoidElement(
    tag: string,
    attributes: array<MvcHtmlAttribute>
): MvcHtml = MvcHtml(1, tag, "", attributes, [], 0)

fun mvcHtmlSelfClosingElement(
    tag: string,
    attributes: array<MvcHtmlAttribute>
): MvcHtml = MvcHtml(1, tag, "", attributes, [], 2)

fun mvcHtmlText(value: string): MvcHtml = MvcHtml(2, "", value, [], [], 0)

fun mvcHtmlDynamic(value: any): MvcHtml = mvcHtmlText("$value")

private fun mvcHtmlNeedsEscape(byte: int): bool =
    byte == 38 || byte == 60 || byte == 62 || byte == 34 || byte == 39

private fun mvcHtmlEscapeEntity(byte: int): string =
    if (byte == 38) "&amp;"
    else if (byte == 60) "&lt;"
    else if (byte == 62) "&gt;"
    else if (byte == 34) "&quot;"
    else "&#39;"

private fun mvcHtmlAppendEscaped(
    var output: ByteBuffer,
    value: string
): void {
    val size = value.size
    var index = 0
    var begin = 0
    while (index < size) {
        if (mvcHtmlNeedsEscape(value[index])) {
            if (index > begin) output.appendText(value.slice(begin, index))
            output.appendText(mvcHtmlEscapeEntity(value[index]))
            begin = index + 1
        }
        index = index + 1
    }
    if (begin < size) output.appendText(value.slice(begin, size))
}

fun mvcEscapeHtml(value: string): string {
    val size = value.size
    var index = 0
    while (index < size && !mvcHtmlNeedsEscape(value[index])) index += 1
    // Ordinary text, including the empty string, needs no allocation or copy.
    if (index == size) return value
    if (size == 1) return mvcHtmlEscapeEntity(value[index])

    val output = byteBuffer()
    var begin = 0
    // Continue at the first hit: do not rescan the already checked prefix.
    while (index < size) {
        if (mvcHtmlNeedsEscape(value[index])) {
            if (index > begin) output.appendText(value.slice(begin, index))
            output.appendText(mvcHtmlEscapeEntity(value[index]))
            begin = index + 1
        }
        index = index + 1
    }
    if (begin < size) output.appendText(value.slice(begin, size))
    output.toText()
}

// kind: 1 opening tag, 2 closing tag, 3 boolean attribute, 4 valued attribute.
// Emit punctuation and a raw tag/attribute name with one bounded reserve.
private trusted fun mvcHtmlAppendMarkup(var output: ByteBuffer, name: string, kind: int): void {
    // Keep the exact phase guard: compile-time effect analysis excludes its
    // else branch, which borrows native pointers.
    if (ablaAtCompileTime()) {
        if (kind == 2) output.appendText("</")
        else if (kind >= 3) output.appendText(" ")
        else output.appendText("<")
        output.appendText(name)
        if (kind == 2) output.appendText(">")
        else if (kind == 4) output.appendText("=\"")
    } else {
        val prefix = if (kind == 2) 2 else 1
        val suffix = if (kind == 2) 1 else if (kind == 4) 2 else 0
        val size = name.size
        val length = prefix + size + suffix
        if (length >= BYTE_BUFFER_LARGE) {
            val before = if (kind == 2) "</" else if (kind >= 3) " " else "<"
            val after = if (kind == 2) ">" else if (kind == 4) "=\"" else ""
            output.appendText("$before$name$after")
            return
        }
        val destination = output.stageReserve(length)
        // Keep name rooted across reserve; no safepoint follows these borrows.
        val source = ablaUnsafeStringAddress(name)
        val pointer = ablaUnsafePointerOffset(ablaUnsafeNullPointer(), destination)
        ablaUnsafeStoreU8(pointer, if (kind >= 3) 32 else 60)
        if (kind == 2) ablaUnsafeStoreU8(ablaUnsafePointerOffset(pointer, 1), 47)
        if (size > 0) ablaUnsafeCopyMemory(destination + prefix, source, size)
        if (kind == 2) ablaUnsafeStoreU8(ablaUnsafePointerOffset(pointer, prefix + size), 62)
        else if (kind == 4) {
            ablaUnsafeStoreU8(ablaUnsafePointerOffset(pointer, prefix + size), 61)
            ablaUnsafeStoreU8(ablaUnsafePointerOffset(pointer, prefix + size + 1), 34)
        }
        output.staged = output.staged + length
        output.byteCount = output.byteCount + length
    }
}

private fun mvcHtmlRenderInto(view: MvcHtml, var output: ByteBuffer): void {
    if (view.kind == 2) {
        mvcHtmlAppendEscaped(output, view.text)
        return
    }
    if (view.kind != 1) return
    mvcHtmlAppendMarkup(output, view.tag, 1)
    for (attribute in view.attributes) {
        mvcHtmlAppendMarkup(output, attribute.name, if (attribute.boolean) 3 else 4)
        if (!attribute.boolean) {
            mvcHtmlAppendEscaped(output, attribute.value)
            output.appendText("\"")
        }
    }
    if (view.closing == 2) output.appendText(" />")
    else output.appendText(">")
    if (view.closing == 1) {
        for (child in view.children) mvcHtmlRenderInto(child, output)
        mvcHtmlAppendMarkup(output, view.tag, 2)
    }
}

private fun mvcHtmlRenderBuffered(view: MvcHtml): string {
    val output = byteBuffer()
    mvcHtmlRenderInto(view, output)
    output.toText()
}

fun MvcHtml.render(): string {
    if (this.kind != 1) {
        if (this.kind == 2) return mvcEscapeHtml(this.text)
        return ""
    }
    // A leaf with few pieces is cheaper as direct templates. Branched trees
    // share one buffer, without creating a rendered string for each child.
    if (this.attributes.size + this.children.size > 2) return mvcHtmlRenderBuffered(this)
    var output = ""
    output = "<${this.tag}"
    var attributeIndex = 0
    while (attributeIndex < this.attributes.size) {
        val attribute = this.attributes[attributeIndex]
        output = "$output ${attribute.name}"
        if (!attribute.boolean) {
            output = "$output=\"${mvcEscapeHtml(attribute.value)}\""
        }
        attributeIndex = attributeIndex + 1
    }
    if (this.closing == 2) output = "$output />"
    else output = "$output>"
    var childIndex = 0
    while (this.closing == 1 && childIndex < this.children.size) {
        output = "$output${this.children[childIndex].render()}"
        childIndex = childIndex + 1
    }
    if (this.closing == 1) output = "$output</${this.tag}>"

    output
}
