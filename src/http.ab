import "abla/http"
import "html.ab"

fun HttpRequest.queryParameter(name: string): string {
    var result = ""
    var pairBegin = 0
    var separator = 0

    while (separator <= this.query.size) {
        if (separator == this.query.size || this.query[separator] == 38) {
            var equals = pairBegin
            while (equals < separator && this.query[equals] != 61) {
                equals = equals + 1
            }

            if (equals < separator &&
                this.query.slice(pairBegin, equals) == name) {
                result = this.query.slice(equals + 1, separator)
            }

            pairBegin = separator + 1
        }
        separator = separator + 1
    }

    result
}

fun mvcHtmlResponse(view: MvcHtml, status: int = 200): HttpResponse =
    HttpResponse(
        status,
        [HttpHeader("Content-Type", "text/html; charset=utf-8")],
        "<!doctype html>${view.render()}"
    )

fun mvcHtmlFragmentResponse(
    view: MvcHtml,
    target: string,
    status: int = 200
): HttpResponse = HttpResponse(
    status,
    [
        HttpHeader("Content-Type", "text/html; charset=utf-8"),
        HttpHeader("Abla-Action", "replace"),
        HttpHeader("Abla-Target", target)
    ],
    view.render()
)

fun mvcResponseHeader(
    response: HttpResponse,
    name: string,
    value: string
): HttpResponse {
    val headers: array<HttpHeader> = []
    var index = 0
    while (index < response.headers.size) {
        if (!httpAsciiEqualInsensitive(response.headers[index].name, name)) {
            headers.append(response.headers[index])
        }
        index = index + 1
    }
    headers.append(HttpHeader(name, value))
    HttpResponse(response.status, headers, response.body)
}

fun mvcNoStore(response: HttpResponse): HttpResponse =
    mvcResponseHeader(response, "Cache-Control", "no-store")

fun mvcPublicCache(
    response: HttpResponse,
    maximumAgeSeconds: int
): HttpResponse = mvcResponseHeader(
    response,
    "Cache-Control",
    "public, max-age=$maximumAgeSeconds"
)

fun mvcImmutableCache(
    response: HttpResponse,
    maximumAgeSeconds: int = 31536000
): HttpResponse = mvcResponseHeader(
    response,
    "Cache-Control",
    "public, max-age=$maximumAgeSeconds, immutable"
)

fun mvcJavaScriptResponse(source: string): HttpResponse = HttpResponse(
    200,
    [HttpHeader("Content-Type", "text/javascript; charset=utf-8")],
    source
)
