#import("abla/compiler/parser")
#import("abla/compiler")
#import("html.ab")
#import("action_core.ab")
#import("client_identity.ab")

compile fun mvcActionHash(text: string, seed: int, factor: int): int {
    var value = seed
    var index = 0
    while (index < text.size) {
        value = value * factor + text[index] + 1
        value = value - value / 1000000007 * 1000000007
        index = index + 1
    }
    value
}

compile fun mvcActionIdentifier(
    cursor: ParserCursor,
    expression: SyntaxExpression
): string {
    val identity =
        "${parserSourceIdentity(cursor)}:${syntaxBegin(expression)}:${syntaxEnd(expression)}"
    val first = mvcActionHash(identity, 17, 257)
    val second = mvcActionHash(identity, 97, 263)
    "abla_mvc_a_${first}_${second}"
}

compile fun mvcFunctionAnnotated(function: int, name: string): bool {
    var found = false
    var index = 0
    while (index < compiler.annotationCount(function)) {
        if (compiler.annotation(function, index) == name) found = true
        index = index + 1
    }
    // A deferred call target can be reflected from a different imported
    // declaration snapshot than functionsAnnotated(). Match the compiler's
    // canonical identity so cross-module annotations remain exact.
    val identity = compiler.functionIdentity(function)
    val annotated = compiler.functionsAnnotated(name)
    index = 0
    while (!found && index < annotated.size) {
        if (compiler.functionIdentity(annotated[index]) == identity) {
            found = true
        }
        index = index + 1
    }
    found
}

compile fun mvcFinalizeAction(
    actionIdentifier: string,
    expression: SyntaxExpression
): GeneratedModuleBuilder {
    val target = typedCallTarget(expression)
    val module = compilerGeneratedModule(actionIdentifier, expression)
    val intType = compilerFindType("i64")
    val stringType = compilerFindType("string")
    val stringArrayType = compilerFindType("array<string>")
    val actionType = compilerFindType("MvcAction")
    val argumentCount = typedCallArgumentCount(expression)
    val argumentKinds: array<string> = []
    var parametersSupported = true
    var allIntegerParameters = true
    var parameter = 0
    while (target >= 0 && parameter < compiler.parameterCount(target)) {
        val parameterType = compiler.parameterType(target, parameter)
        if (parameterType == "i64") {
            argumentKinds.append("int")
        } else if (parameterType == "string") {
            argumentKinds.append("string")
            allIntegerParameters = false
        } else {
            parametersSupported = false
            allIntegerParameters = false
        }
        parameter = parameter + 1
    }
    val callValid = target >= 0 && intType >= 0 && stringType >= 0 &&
        stringArrayType >= 0 && typedExpressionKind(expression) == "call" &&
        compiler.parameterCount(target) == argumentCount &&
        parametersSupported

    val client = target >= 0 && mvcFunctionAnnotated(target, "client")
    val clientValid = callValid && client && allIntegerParameters &&
        compiler.resultType(target) == "i64"
    val serverValid = callValid && !client && actionType >= 0 &&
        compilerFunctionResultTypeHandle(target) == actionType

    if (serverValid) {
        val parameterNames: array<string> = []
        val parameterTypes: array<int> = []
        val targetArguments: array<SyntaxExpression> = []
        if (argumentCount <= 1) {
            if (argumentCount == 1) {
                parameterNames.append("argument")
                if (argumentKinds[0] == "int") parameterTypes.append(intType)
                if (argumentKinds[0] == "string") {
                    parameterTypes.append(stringType)
                }
                targetArguments.append(syntaxIdentifier("argument"))
            }
        } else {
            parameterNames.append("arguments")
            parameterTypes.append(stringArrayType)
            parameter = 0
            while (parameter < argumentCount) {
                val conversionArguments: array<SyntaxExpression> = [
                    syntaxIdentifier("arguments"),
                    syntaxInteger(parameter)
                ]
                var conversion = "mvcActionIntegerAt"
                if (argumentKinds[parameter] == "string") {
                    conversion = "mvcActionStringAt"
                }
                targetArguments.append(syntaxCall(
                    conversion,
                    conversionArguments
                ))
                parameter = parameter + 1
            }
        }
        compilerGeneratedFunction(
            module,
            "adapter",
            parameterNames,
            parameterTypes,
            actionType,
            syntaxCallTarget(target, targetArguments)
        )

        val exportedArguments: array<SyntaxExpression> = []
        if (argumentCount == 1) {
            exportedArguments.append(syntaxIdentifier("argument"))
        }
        if (argumentCount > 1) {
            exportedArguments.append(syntaxIdentifier("arguments"))
        }
        compilerGeneratedExportFunction(
            module,
            actionIdentifier,
            parameterNames,
            parameterTypes,
            actionType,
            compilerGeneratedDeclarationCall(module, 0, exportedArguments)
        )

        val registrationArguments: array<SyntaxExpression> = [
            syntaxString(actionIdentifier)
        ]
        var registrationFunction = "mvcRegisterGeneratedNoArgumentAction"
        if (argumentCount == 1 && argumentKinds[0] == "int") {
            registrationFunction = "mvcRegisterGeneratedIntAction"
        }
        if (argumentCount == 1 && argumentKinds[0] == "string") {
            registrationFunction = "mvcRegisterGeneratedStringAction"
        }
        if (argumentCount > 1) {
            registrationFunction = "mvcRegisterGeneratedArgumentsAction"
            val kindSyntax: array<SyntaxExpression> = []
            parameter = 0
            while (parameter < argumentKinds.size) {
                kindSyntax.append(syntaxString(argumentKinds[parameter]))
                parameter = parameter + 1
            }
            registrationArguments.append(syntaxArray(kindSyntax))
        }
        registrationArguments.append(
            compilerGeneratedDeclarationReference(module, 1)
        )
        compilerGeneratedValue(
            module,
            "registration",
            intType,
            syntaxCall(registrationFunction, registrationArguments)
        )
    } else if (clientValid) {
        val parameterNames: array<string> = []
        val parameterTypes: array<int> = []
        val targetArguments: array<SyntaxExpression> = []
        parameter = 0
        while (parameter < argumentCount) {
            val parameterName = "argument$parameter"
            parameterNames.append(parameterName)
            parameterTypes.append(intType)
            targetArguments.append(syntaxIdentifier(parameterName))
            parameter = parameter + 1
        }
        compilerGeneratedExportFunction(
            module,
            "${actionIdentifier}_client",
            parameterNames,
            parameterTypes,
            intType,
            syntaxCallTarget(target, targetArguments)
        )
    } else {
        var invalidType = "MissingMvcActionType"
        if (target < 0) invalidType = "MissingMvcResolvedTarget"
        else if (typedExpressionKind(expression) != "call") {
            invalidType = "MissingMvcDirectCall"
        } else if (compiler.parameterCount(target) != argumentCount) {
            invalidType = "MissingMvcMatchingParameterCount"
        } else if (!parametersSupported) {
            invalidType = "MissingMvcIntegerOrStringParameters"
        } else if (client && !allIntegerParameters) {
            invalidType = "MissingMvcClientIntegerParameters"
        } else if (!client && compiler.resultType(target) == "i64") {
            invalidType = "MissingMvcClientAnnotation"
        } else if (client) {
            invalidType = "MissingMvcClientIntegerResult"
        } else {
            invalidType = "MissingMvcServerActionResult"
        }
        val invalidNames: array<string> = []
        val invalidTypes: array<int> = []
        compilerGeneratedFunction(
            module,
            "invalidMvcActionSignature",
            invalidNames,
            invalidTypes,
            compilerFindType(invalidType),
            syntaxInteger(0)
        )
    }
    module
}

compile fun mvcSyntaxUnaryCall(
    name: string,
    value: SyntaxExpression
): SyntaxExpression {
    val arguments: array<SyntaxExpression> = []
    arguments.append(value)
    syntaxCall(name, arguments)
}

compile fun mvcSyntaxAttribute(
    name: string,
    value: SyntaxExpression
): SyntaxExpression {
    val arguments: array<SyntaxExpression> = []
    arguments.append(syntaxString(name))
    arguments.append(value)
    syntaxCall("mvcHtmlAttributeValue", arguments)
}

compile fun mvcSyntaxBooleanAttribute(name: string): SyntaxExpression {
    val arguments: array<SyntaxExpression> = [syntaxString(name)]
    syntaxCall("mvcHtmlBooleanAttribute", arguments)
}

compile fun mvcVoidTag(tag: string): bool =
    tag == "area" || tag == "base" || tag == "br" || tag == "col" ||
    tag == "embed" || tag == "hr" || tag == "img" || tag == "input" ||
    tag == "link" || tag == "meta" || tag == "param" ||
    tag == "source" || tag == "track" || tag == "wbr"

compile fun mvcParseActionAttributes(
    cursor: ParserCursor
): array<SyntaxExpression> {
    val attributes: array<SyntaxExpression> = []
    parserRawExpect(cursor, "{")
    val action = parserParseAblaExpression(cursor)
    parserRawExpect(cursor, "}")
    if (syntaxKind(action) != "call") {
        parserFail(
            cursor,
            "MVC action must be a direct function call"
        )
    }

    val actionIdentifier = mvcActionIdentifier(cursor, action)
    compilerRecordGeneratedExtensionRequest(
        actionIdentifier,
        actionIdentifier,
        action,
        mvcFinalizeAction
    )

    attributes.append(mvcSyntaxAttribute(
        "data-abla-action",
        syntaxString(actionIdentifier)
    ))
    attributes.append(mvcSyntaxAttribute(
        "data-abla-client-export",
        syntaxString(mvcClientExportIdentifierForName(syntaxText(action)))
    ))
    val argumentCount = syntaxChildCount(action)
    if (argumentCount == 1) {
        attributes.append(mvcSyntaxAttribute(
            "data-abla-argument",
            syntaxChild(action, 0)
        ))
    }
    if (argumentCount > 1) {
        attributes.append(mvcSyntaxAttribute(
            "data-abla-argument-count",
            syntaxInteger(argumentCount)
        ))
        var argument = 0
        while (argument < argumentCount) {
            attributes.append(mvcSyntaxAttribute(
                "data-abla-argument-$argument",
                syntaxChild(action, argument)
            ))
            argument = argument + 1
        }
    }
    attributes
}

compile fun mvcParseAttribute(
    cursor: ParserCursor
): array<SyntaxExpression> {
    val attributes: array<SyntaxExpression> = []
    // HTML attribute names may contain hyphens and colons. Read until the
    // first attribute delimiter instead of using the alphanumeric-only name
    // helper used for Abla identifiers and element names.
    val sourceName = parserRawTakeUntil(cursor, " \t\r\n=/>")
    if (sourceName == "") parserFail(cursor, "expected an HTML attribute")
    parserRawSkipWhitespace(cursor)

    if (!parserRawAt(cursor, "=")) {
        if (sourceName == "onclick" || sourceName == "update" ||
            sourceName == "poll" || sourceName == "every") {
            parserFail(cursor, "MVC behavior attributes require a value")
        }
        attributes.append(mvcSyntaxBooleanAttribute(sourceName))
        return attributes
    }
    parserRawExpect(cursor, "=")
    parserRawSkipWhitespace(cursor)

    if (sourceName == "onclick") {
        val actionAttributes = mvcParseActionAttributes(cursor)
        var actionIndex = 0
        while (actionIndex < actionAttributes.size) {
            attributes.append(actionAttributes[actionIndex])
            actionIndex = actionIndex + 1
        }
    } else {
        var outputName = sourceName
        if (sourceName == "update") outputName = "data-abla-update"
        if (sourceName == "poll") outputName = "data-abla-poll"
        if (sourceName == "every") outputName = "data-abla-poll-every"

        if (parserRawAt(cursor, "\"")) {
            parserRawExpect(cursor, "\"")
            val value = parserRawTakeUntil(cursor, "\"")
            parserRawExpect(cursor, "\"")
            attributes.append(mvcSyntaxAttribute(
                outputName,
                syntaxString(value)
            ))
        } else if (parserRawAt(cursor, "'")) {
            parserRawExpect(cursor, "'")
            val value = parserRawTakeUntil(cursor, "'")
            parserRawExpect(cursor, "'")
            attributes.append(mvcSyntaxAttribute(
                outputName,
                syntaxString(value)
            ))
        } else if (parserRawAt(cursor, "{")) {
            parserRawExpect(cursor, "{")
            val value = parserParseAblaExpression(cursor)
            parserRawExpect(cursor, "}")
            attributes.append(mvcSyntaxAttribute(outputName, value))
        } else {
            parserFail(
                cursor,
                "MVC attribute '$sourceName' must use a quoted value or an Abla expression"
            )
        }
    }
    attributes
}

compile fun mvcParseElement(cursor: ParserCursor): SyntaxExpression {
    parserRawSkipWhitespace(cursor)
    parserRawExpect(cursor, "<")
    val tag = parserRawTakeUntil(cursor, " \t\r\n/>")
    if (tag == "") parserFail(cursor, "expected an HTML tag name")

    val attributes: array<SyntaxExpression> = []
    parserRawSkipWhitespace(cursor)
    while (!parserRawAt(cursor, ">") && !parserRawAt(cursor, "/>")) {
        val parsedAttributes = mvcParseAttribute(cursor)
        var parsedAttribute = 0
        while (parsedAttribute < parsedAttributes.size) {
            attributes.append(parsedAttributes[parsedAttribute])
            parsedAttribute = parsedAttribute + 1
        }
        parserRawSkipWhitespace(cursor)
    }
    var selfClosing = false
    if (parserRawAt(cursor, "/>")) {
        parserRawExpect(cursor, "/>")
        selfClosing = true
    } else {
        parserRawExpect(cursor, ">")
    }

    val elementArguments: array<SyntaxExpression> = [
        syntaxString(tag),
        syntaxArray(attributes)
    ]
    if (selfClosing) {
        return syntaxCall("mvcHtmlSelfClosingElement", elementArguments)
    }
    if (mvcVoidTag(tag)) {
        if (parserRawAt(cursor, "</$tag")) {
            parserRawExpect(cursor, "</$tag")
            parserRawSkipWhitespace(cursor)
            parserRawExpect(cursor, ">")
        }
        return syntaxCall("mvcHtmlVoidElement", elementArguments)
    }

    val children: array<SyntaxExpression> = []
    var closed = false
    while (!closed) {
        if (parserRawEnd(cursor)) {
            closed = true
            parserFail(cursor, "unterminated MVC view element <$tag>")
        } else if (parserRawAt(cursor, "</")) {
            closed = true
        } else if (parserRawAt(cursor, "<")) {
            children.append(mvcParseElement(cursor))
        } else if (parserRawAt(cursor, "{")) {
            parserRawExpect(cursor, "{")
            val value = parserParseAblaExpression(cursor)
            parserRawExpect(cursor, "}")
            children.append(mvcSyntaxUnaryCall("mvcHtmlDynamic", value))
        } else {
            val value = parserRawTakeUntil(cursor, "<{")
            if (value != "") {
                children.append(mvcSyntaxUnaryCall(
                    "mvcHtmlText",
                    syntaxString(value)
                ))
            }
        }
    }

    parserRawExpect(cursor, "</")
    val closingTag = parserRawTakeUntil(cursor, " \t\r\n>")
    if (closingTag != tag) {
        parserFail(
            cursor,
            "closing MVC view tag </$closingTag> does not match <$tag>"
        )
    }
    parserRawSkipWhitespace(cursor)
    parserRawExpect(cursor, ">")

    elementArguments.append(syntaxArray(children))
    syntaxCall("mvcHtmlElement", elementArguments)
}

#compilerRegisterSubparser("mvcview", mvcParseElement)
