import "abla/compiler"
import "abla/wasm/build"
import "client_identity.ab"

// Selects the current program's @client functions by typed handle, copies only
// their reachable code into a fresh program, and gives each copy its stable
// browser ABI name. The compiler owns the child entry and export adapters.
compile fun mvcEmitClientModule(
    name: string = "abla-mvc-client",
    output: string = "build/abla-mvc-client/client.wasm",
    fast: bool = true,
    cache: bool = false
): bool {
    val functions = compiler.functionsAnnotated("client")
    var valid = functions.size > 0
    if (valid) {
        val module = compiler.newModule(name)
        var index = 0
        while (index < functions.size) {
            val function = functions[index]
            var supported = compiler.resultType(function) == "i64"
            var parameter = 0
            while (parameter < compiler.parameterCount(function)) {
                if (compiler.parameterType(function, parameter) != "i64") {
                    supported = false
                }
                parameter = parameter + 1
            }
            if (supported) {
                valid = module.use(
                    compiler.reference(function).exported(
                        mvcClientExportIdentifier(function)
                    )
                ) && valid
            } else {
                // Use the independent-module boundary for a stable build
                // diagnostic instead of silently leaving a stale artifact.
                valid = module.use(compiler.reference(-1)) && valid
            }
            index = index + 1
        }
        if (valid) {
            valid = module.emitWasm(output, fast = fast, cache = cache)
        }
    }
    valid
}

// Backwards-compatible zero-argument compile action used by existing client
// composition roots.
compile fun mvcBuildClientArtifact(): void {
    mvcEmitClientModule()
    return
}
