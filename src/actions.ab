import "abla/http"
import "action_core.ab"
import "forms.ab"
import "http.ab"

class MvcParsedInt(
    val value: int,
    val valid: bool
)

fun mvcParseInt(text: string): MvcParsedInt {
    var value = 0
    var valid = text.size > 0
    var index = 0
    while (index < text.size) {
        val byte = text[index]
        if (byte < 48 || byte > 57) {
            valid = false
        } else if (valid) {
            value = value * 10 + byte - 48
        }
        index = index + 1
    }
    MvcParsedInt(value, valid)
}

fun MvcActions.dispatch(request: HttpRequest): HttpResponse {
    val actionName = request.parameter("name")
    var selected = -1
    var selectedKind = 0
    var index = 0
    while (index < this.intActions.size) {
        if (this.intActions[index].name == actionName) {
            selected = index
            selectedKind = 1
        }
        index = index + 1
    }

    index = 0
    while (index < this.stringActions.size) {
        if (this.stringActions[index].name == actionName) {
            selected = index
            selectedKind = 2
        }
        index = index + 1
    }

    index = 0
    while (index < this.noArgumentActions.size) {
        if (this.noArgumentActions[index].name == actionName) {
            selected = index
            selectedKind = 3
        }
        index = index + 1
    }


    index = 0
    while (index < this.argumentsActions.size) {
        if (this.argumentsActions[index].name == actionName) {
            selected = index
            selectedKind = 4
        }
        index = index + 1
    }

    var response = httpText("action not found", 404)
    if (selectedKind == 1) {
        val argument = mvcParseInt(request.queryParameter("argument"))
        if (!argument.valid) {
            response = httpText("invalid integer action argument", 400)
        } else {
            val handler = this.intActions[selected].handler
            response = mvcActionResponse(handler(argument.value))
        }
    }
    if (selectedKind == 2) {
        val handler = this.stringActions[selected].handler
        val argument = mvcFormDecode(request.queryParameter("argument"))
        response = mvcActionResponse(handler(argument))
    }
    if (selectedKind == 3) {
        val handler = this.noArgumentActions[selected].handler
        response = mvcActionResponse(handler())
    }
    if (selectedKind == 4) {
        val selectedAction = this.argumentsActions[selected]
        val arguments: array<string> = []
        var valid = true
        index = 0
        while (index < selectedAction.argumentKinds.size) {
            val argument = mvcFormDecode(
                request.queryParameter("argument$index")
            )
            if (selectedAction.argumentKinds[index] == "int" &&
                !mvcParseInt(argument).valid) valid = false
            arguments.append(argument)
            index = index + 1
        }
        if (valid) {
            val handler = selectedAction.handler
            response = mvcActionResponse(handler(arguments))
        } else {
            response = httpText("invalid action arguments", 400)
        }
    }
    response
}

fun mvcActionResponse(action: MvcAction): HttpResponse {
    var response = httpText("unsupported action result", 500)
    if (action.kind == 1) {
        response = mvcHtmlFragmentResponse(action.content, action.target)
    }
    response
}

fun mvcActionHttpHandler(
    actions: MvcActions
): (HttpRequest) -> HttpResponse = {
    request: HttpRequest -> actions.dispatch(request)
}

class MvcBrowserRuntimeOptions(
    val wasmPath: string,
    val actionPath: string,
    val wasmCacheMode: string,
    val sessionStorageKey: string
)

fun mvcBrowserRuntimeOptions(
    wasmPath: string = "/assets/abla-mvc-client.wasm",
    actionPath: string = "/__abla/action/",
    wasmCacheMode: string = "no-cache",
    sessionStorageKey: string = "abla-mvc-session"
): MvcBrowserRuntimeOptions = MvcBrowserRuntimeOptions(
    wasmPath,
    actionPath,
    wasmCacheMode,
    sessionStorageKey
)

fun mvcJavaScriptString(value: string): string {
    var output = ""
    var index = 0
    while (index < value.size) {
        val byte = value[index]
        if (byte == 34) output = "${output}\\\""
        else if (byte == 92) output = "${output}\\\\"
        else if (byte == 10) output = "${output}\\n"
        else if (byte == 13) output = "${output}\\r"
        else output = "$output${value.slice(index, index + 1)}"
        index = index + 1
    }
    output
}

fun mvcBrowserRuntime(
    options: MvcBrowserRuntimeOptions = mvcBrowserRuntimeOptions()
): string {
    val wasmPath = mvcJavaScriptString(options.wasmPath)
    val actionPath = mvcJavaScriptString(options.actionPath)
    val wasmCacheMode = mvcJavaScriptString(options.wasmCacheMode)
    val sessionStorageKey = mvcJavaScriptString(options.sessionStorageKey)
    var output = "(function () {\n"
    output = "${output}  var clientModule;\n"
    output = "${output}  var sessionKey = \"$sessionStorageKey\";\n"
    output = "${output}  function loadClientModule() {\n"
    output = "${output}    if (!clientModule) {\n"
    output = "${output}      clientModule = fetch(\"$wasmPath\", { cache: \"$wasmCacheMode\" }).then(function (response) {\n"
    output = "${output}        if (!response.ok) throw new Error(\"Unable to load Abla client module\");\n"
    output = "${output}        return response.arrayBuffer();\n"
    output = "${output}      }).then(function (bytes) { return WebAssembly.instantiate(bytes, {}); });\n"
    output = "${output}    }\n"
    output = "${output}    return clientModule;\n"
    output = "${output}  }\n"
    output = "${output}  function actionArguments(trigger) {\n"
    output = "${output}    var values = [];\n"
    output = "${output}    var count = Number(trigger.getAttribute(\"data-abla-argument-count\") || 0);\n"
    output = "${output}    if (count > 0) {\n"
    output = "${output}      for (var index = 0; index < count; index += 1) values.push(trigger.getAttribute(\"data-abla-argument-\" + index) || \"\");\n"
    output = "${output}    } else if (trigger.hasAttribute(\"data-abla-argument\")) {\n"
    output = "${output}      values.push(trigger.getAttribute(\"data-abla-argument\") || \"\");\n"
    output = "${output}    }\n"
    output = "${output}    return values;\n"
    output = "${output}  }\n"
    output = "${output}  function replaceTarget(selector, body) {\n"
    output = "${output}    var target = selector && document.querySelector(selector);\n"
    output = "${output}    if (target) { target.outerHTML = body; initializePollers(document); }\n"
    output = "${output}  }\n"
    output = "${output}  function dispatchServer(trigger, action, values) {\n"
    output = "${output}    var parameters = new URLSearchParams();\n"
    output = "${output}    if (values.length === 1) parameters.set(\"argument\", values[0]);\n"
    output = "${output}    if (values.length > 1) values.forEach(function (value, index) { parameters.set(\"argument\" + index, value); });\n"
    output = "${output}    var query = parameters.toString();\n"
    output = "${output}    var url = \"$actionPath\" + encodeURIComponent(action) + (query ? \"?\" + query : \"\");\n"
    output = "${output}    fetch(url, { method: \"POST\" }).then(function (response) {\n"
    output = "${output}      return response.text().then(function (body) {\n"
    output = "${output}        if (!response.ok) throw new Error(body);\n"
    output = "${output}        var behavior = response.headers.get(\"Abla-Action\");\n"
    output = "${output}        var selector = response.headers.get(\"Abla-Target\") || trigger.getAttribute(\"data-abla-update\");\n"
    output = "${output}        if (behavior === \"replace\" && selector) replaceTarget(selector, body);\n"
    output = "${output}      });\n"
    output = "${output}    }).catch(function (error) { console.error(error); });\n"
    output = "${output}  }\n"
    output = "${output}  function sessionIdentifier() {\n"
    output = "${output}    var value = sessionStorage.getItem(sessionKey);\n"
    output = "${output}    if (!value) {\n"
    output = "${output}      if (globalThis.crypto && crypto.getRandomValues) {\n"
    output = "${output}        var random = new Uint32Array(4); crypto.getRandomValues(random);\n"
    output = "${output}        value = Array.from(random).map(function (part) { return part.toString(16); }).join(\"\");\n"
    output = "${output}      } else { value = Date.now().toString(16) + Math.random().toString(16).slice(2); }\n"
    output = "${output}      sessionStorage.setItem(sessionKey, value);\n"
    output = "${output}    }\n"
    output = "${output}    return value;\n"
    output = "${output}  }\n"
    output = "${output}  function pollMilliseconds(value) {\n"
    output = "${output}    var text = (value || \"5s\").trim();\n"
    output = "${output}    var duration = text.endsWith(\"ms\") ? Number(text.slice(0, -2)) : text.endsWith(\"s\") ? Number(text.slice(0, -1)) * 1000 : Number(text);\n"
    output = "${output}    return Number.isFinite(duration) && duration >= 100 ? duration : 5000;\n"
    output = "${output}  }\n"
    output = "${output}  function startPolling(element) {\n"
    output = "${output}    if (element.hasAttribute(\"data-abla-poll-active\")) return;\n"
    output = "${output}    element.setAttribute(\"data-abla-poll-active\", \"true\");\n"
    output = "${output}    var busy = false;\n"
    output = "${output}    var timer;\n"
    output = "${output}    function tick() {\n"
    output = "${output}      if (!element.isConnected) { clearInterval(timer); return; }\n"
    output = "${output}      if (document.hidden || busy) return;\n"
    output = "${output}      busy = true;\n"
    output = "${output}      fetch(element.getAttribute(\"data-abla-poll\"), { headers: { \"Abla-Session\": sessionIdentifier() } }).then(function (response) {\n"
    output = "${output}        return response.text().then(function (body) {\n"
    output = "${output}          if (!response.ok) throw new Error(body);\n"
    output = "${output}          var selector = response.headers.get(\"Abla-Target\") || element.getAttribute(\"data-abla-update\");\n"
    output = "${output}          if (selector) replaceTarget(selector, body);\n"
    output = "${output}          element.removeAttribute(\"data-abla-poll-error\");\n"
    output = "${output}        });\n"
    output = "${output}      }).catch(function (error) { element.setAttribute(\"data-abla-poll-error\", \"true\"); console.error(error); }).finally(function () { busy = false; });\n"
    output = "${output}    }\n"
    output = "${output}    tick();\n"
    output = "${output}    timer = setInterval(tick, pollMilliseconds(element.getAttribute(\"data-abla-poll-every\")));\n"
    output = "${output}  }\n"
    output = "${output}  function initializePollers(root) {\n"
    output = "${output}    if (root.matches && root.matches(\"[data-abla-poll]\")) startPolling(root);\n"
    output = "${output}    root.querySelectorAll(\"[data-abla-poll]\").forEach(startPolling);\n"
    output = "${output}  }\n"
    output = "${output}  document.addEventListener(\"click\", function (event) {\n"
    output = "${output}    var trigger = event.target.closest(\"[data-abla-action]\");\n"
    output = "${output}    if (!trigger) return;\n"
    output = "${output}    event.preventDefault();\n"
    output = "${output}    var action = trigger.getAttribute(\"data-abla-action\");\n"
    output = "${output}    var values = actionArguments(trigger);\n"
    output = "${output}    var clientExport = trigger.getAttribute(\"data-abla-client-export\");\n"
    output = "${output}    loadClientModule().then(function (loaded) {\n"
    output = "${output}        var handler = loaded.instance.exports[clientExport];\n"
    output = "${output}        if (typeof handler !== \"function\") {\n"
    output = "${output}          dispatchServer(trigger, action, values);\n"
    output = "${output}          return;\n"
    output = "${output}        }\n"
    output = "${output}        var selector = trigger.getAttribute(\"data-abla-update\");\n"
    output = "${output}        var target = selector && document.querySelector(selector);\n"
    output = "${output}        if (values.length === 1 && target) values[0] = target.textContent.trim();\n"
    output = "${output}        var result = handler.apply(null, values.map(function (value) { return BigInt(value); }));\n"
    output = "${output}        if (target) target.textContent = result.toString();\n"
    output = "${output}        if (values.length === 1) trigger.setAttribute(\"data-abla-argument\", result.toString());\n"
    output = "${output}        if (values.length > 1) trigger.setAttribute(\"data-abla-argument-0\", result.toString());\n"
    output = "${output}    }).catch(function () {\n"
    output = "${output}      dispatchServer(trigger, action, values);\n"
    output = "${output}    });\n"
    output = "${output}  });\n"
    output = "${output}  if (document.readyState === \"loading\") document.addEventListener(\"DOMContentLoaded\", function () { initializePollers(document); });\n"
    output = "${output}  else initializePollers(document);\n"
    output = "${output}})();\n"
    output
}

fun mvcBrowserRuntimeEndpoint(request: HttpRequest): HttpResponse =
    mvcNoStore(mvcJavaScriptResponse(mvcBrowserRuntime()))

fun mvcBrowserRuntimeHandler(
    options: MvcBrowserRuntimeOptions
): (HttpRequest) -> HttpResponse = {
    request: HttpRequest ->
        mvcNoStore(mvcJavaScriptResponse(mvcBrowserRuntime(options)))
}
